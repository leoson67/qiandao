[
    {
        "comment": "登录状态检查 + 触发每日积分发放（每日登录自动领，无独立领取接口）",
        "request": {
            "method": "GET",
            "url": "https://xiaohuanxiong.com/api/web/office/v3/setting_info",
            "headers": [
                {
                    "name": "Referer",
                    "value": "https://xiaohuanxiong.com/work/home"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
                },
                {
                    "name": "Authorization",
                    "value": "Bearer {{ ((cookie|trim)|regex_replace(\"(?s).*raccoon_token=([^;]+).*\", \"\\\\1\")) }}"
                }
            ],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [
                { "re": "200", "from": "status" }
            ],
            "failed_asserts": [
                { "re": "\"code\"\\s*:\\s*[1-9]\\d*", "from": "content" }
            ],
            "extract_variables": []
        }
    },
    {
        "comment": "查询当前积分余额，写入日志",
        "request": {
            "method": "GET",
            "url": "https://xiaohuanxiong.com/api/web/points/v1/balance",
            "headers": [
                {
                    "name": "Referer",
                    "value": "https://xiaohuanxiong.com/work/home"
                },
                {
                    "name": "User-Agent",
                    "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
                },
                {
                    "name": "Authorization",
                    "value": "Bearer {{ ((cookie|trim)|regex_replace(\"(?s).*raccoon_token=([^;]+).*\", \"\\\\1\")) }}"
                }
            ],
            "cookies": [],
            "data": ""
        },
        "rule": {
            "success_asserts": [
                { "re": "200", "from": "status" }
            ],
            "failed_asserts": [
                { "re": "\"code\"\\s*:\\s*[1-9]\\d*", "from": "content" }
            ],
            "extract_variables": [
                {
                    "name": "__log__",
                    "re": "(?s).{0,300}",
                    "from": "content"
                }
            ]
        }
    }
]
